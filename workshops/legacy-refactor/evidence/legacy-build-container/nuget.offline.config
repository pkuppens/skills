<?xml version="1.0" encoding="utf-8"?>
<!-- Offline restore source. <clear /> removes nuget.org, so a restore that
     passes with this file provably used the vendored feed only. -->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="/work/build-container/nuget-feed" />
  </packageSources>
</configuration>
